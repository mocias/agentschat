{
  "name": "dsh-agent-room",
  "productName": "agentschat",
  "version": "0.1.36",
  "private": true,
  "description": "agentschat — local conversations with AI agents, together or one to one.",
  "author": "mocias",
  "type": "module",
  "scripts": {
    "start": "node standalone/server.cjs",
    "test": "node --test checks/*.test.cjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:pack": "electron-builder --config desktop/builder.cjs --win --x64 --dir",
    "desktop:dist": "electron-builder --config desktop/builder.cjs --win nsis --x64",
    "desktop:smoke": "node scripts/smoke-desktop.cjs"
  },
  "main": "lib/index.js",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "agent-room-skill.md",
    "standalone",
    "lib",
    "public",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.1"
  }
}
